{
    "name": "toneflix/paystack-php",
    "description": "A modern, dependency-light PHP client for the Paystack API.",
    "keywords": [
        "paystack",
        "payments",
        "php",
        "api",
        "sdk",
        "toneflix"
    ],
    "homepage": "https://github.com/toneflix/paystack-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Legacy",
            "email": "code@toneflix.com.ng",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Toneflix\\Paystack\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Toneflix\\Paystack\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
